{{ 'section-calendar.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shop — every product that isn't an event ticket, shown with the events page's grid view
  (grid only, no list view) and the same assets/section-calendar.css / .js.

  The hidden .calendar-row links below are the data source the calendar JS packs into the grid
  (same as on the events page); rows are grouped under their category (product type) instead of
  a month, via data-group. Filters: All / In Stock (data-filter="in-stock").

  Tickets are excluded by product type "Ticket" or the event metafield.

  Products: a plain collection loop stops at 50 products, and tickets make up most of the
  store, so shop products past the first 50 would silently disappear. Instead this pages
  through collections.all with {% paginate %} at the 250 maximum and only renders page 1 — 250
  products total, tickets included — and applies the optional collection setting as a filter
  inside the loop. Same {% paginate %} constraints as sections/archives.liquid: it must target
  collections.all.products directly, `by` takes no colon, and its output can't be captured —
  so the rows always render straight into the page, and the empty state is left to the JS
  (it shows .calendar-coming-soon when there are no rows).
{%- endcomment -%}

{%- liquid
  assign evt_ns = settings.event_metafield_namespace | default: 'event_ticketing'
  assign evt_key = settings.event_metafield_key | default: 'event_v2'

  assign shop_collection = section.settings.collection

  assign page_title = section.settings.title | default: 'Shop'
  assign placeholder_color = section.settings.placeholder_color | default: '#B7C9B7'
  assign placeholder_font = section.settings.placeholder_font_color | default: '#87A587'
-%}

<section class="calendar-page mode-grid" id="cal-page-container" data-grid-only
  style="--placeholder-bg: {{ placeholder_color }}; --placeholder-font: {{ placeholder_font }}"
  data-colors="{% render 'palette-color', source: section.settings.gradient_color_1_source, custom: section.settings.gradient_color_1 %}, {% render 'palette-color', source: section.settings.gradient_color_2_source, custom: section.settings.gradient_color_2 %}, {% render 'palette-color', source: section.settings.gradient_color_3_source, custom: section.settings.gradient_color_3 %}"
  data-edge="0"
  {% render 'calendar-stickers', settings_source: section.settings %}
>
  <div class="calendar-header">
    <h1 class="type-display-hero animate-cascade fit-text desktop-only">
      {{ page_title }}
    </h1>
    <div class="calendar-title-mobile mobile-only">
      {%- assign title_words = page_title | split: ' ' -%}
      {%- for word in title_words -%}
        <div class="type-display-hero fit-text" data-fit-managed>{{ word }}</div>
      {%- endfor -%}
    </div>

    <div class="calendar-controls">
      <div class="filters-list">
        <div class="text-mask">
          <span class="type-subRegular1 text-reveal-inner">{{ 'events.filters' | t }}</span>
        </div>
        <button class="filter-btn type-subRegular1 ui-roll roll-hover active" data-filter="all">
          <span class="ui-roll-layer ui-roll-visible">{{ 'events.all' | t }}</span>
          <span class="ui-roll-layer ui-roll-hidden">{{ 'events.all' | t }}</span>
        </button>
        <button class="filter-btn type-subRegular1 ui-roll roll-hover" data-filter="in-stock">
          <span class="ui-roll-layer ui-roll-visible">{{ 'shop.in_stock' | t }}</span>
          <span class="ui-roll-layer ui-roll-hidden">{{ 'shop.in_stock' | t }}</span>
        </button>
      </div>
    </div>
  </div>

  <div class="calendar-body">
    {%- comment -%} hidden in grid mode — the rows only feed the grid packer {%- endcomment -%}
    <div class="calendar-interface-wrapper">
      <div class="calendar-list">
        {%- paginate collections.all.products by 250 -%}
          {%- assign shop_products = collections.all.products | sort: 'type' -%}
          {%- for product in shop_products -%}
            {%- liquid
              if product.type == 'Ticket' or product.metafields[evt_ns][evt_key] != blank
                continue
              endif
              if shop_collection != blank
                unless product.collections contains shop_collection
                  continue
                endunless
              endif

              assign row_status = ''
              if product.tags contains 'upcoming'
                assign row_status = 'coming-soon'
              elsif product.available == false
                assign row_status = 'sold-out'
              endif

              assign row_group = product.type | default: page_title
            -%}
            <a href="{{ product.url }}" class="calendar-row"
              data-img="{{ product.featured_image | image_url: width: 800 }}"
              data-title="{{ product.title | escape }}"
              data-group="{{ row_group | escape }}"
              {%- if row_status != blank %} data-status="{{ row_status }}"{% endif -%}
            >
              <span class="cal-name type-h3">{{ product.title }}</span>
            </a>
          {%- endfor -%}
        {%- endpaginate -%}
      </div>
    </div>

    <div id="dynamic-grid-container" class="calendar-grid-packed"></div>
  </div>
  <div class="calendar-coming-soon"><span class="type-h2">{{ section.settings.empty_message | default: 'more goods coming soon!' }}</span></div>
</section>

<script src="{{ 'section-calendar.js' | asset_url }}" defer></script>

